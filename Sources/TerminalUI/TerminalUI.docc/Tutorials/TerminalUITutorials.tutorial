@Tutorials(name: "TerminalUI") {
    @Intro(title: "Building terminal apps with TerminalUI") {
        Learn the framework the way you'll actually use it: by building an
        app. Each tutorial is a sequence of small steps, and every step's
        code is a complete program you can run with `swift run`.

        For the concepts behind the steps — the attribute graph, the layout
        model, rendering — see the articles under Essentials on the
        documentation landing page.
    }

    @Chapter(name: "Foundations") {
        Stand up an app, drive it from observable state, and handle keys.

        @Image(source: "tutorial-tasks-card.png", alt: "The TerminalUI mascot.")

        @TutorialReference(tutorial: "doc:BuildATaskList")
    }

    @Chapter(name: "Interaction") {
        Text input, focus discipline, and the mouse — the difference
        between a demo and a tool.

        @Image(source: "tutorial-tasks-card.png", alt: "The TerminalUI mascot.")

        @TutorialReference(tutorial: "doc:AddInputAndTheMouse")
    }

    @Chapter(name: "Structure") {
        Tabs, split panes, and a settings form that changes the app live —
        composing screens once one stops being enough.

        @Image(source: "tutorial-tasks-card.png", alt: "The TerminalUI mascot.")

        @TutorialReference(tutorial: "doc:GiveItStructure")
    }

    @Chapter(name: "Navigation") {
        Push and pop with a navigation stack — and the judgment call
        between drilling down and showing both at once.

        @Image(source: "tutorial-tasks-card.png", alt: "The TerminalUI mascot.")

        @TutorialReference(tutorial: "doc:NavigateToDetail")
    }

    @Chapter(name: "Data") {
        Tables, sparklines, bars, and gauges — choosing the display form
        that fits what the number means.

        @Image(source: "tutorial-tasks-card.png", alt: "The TerminalUI mascot.")

        @TutorialReference(tutorial: "doc:ShowTheNumbers")
    }

    @Chapter(name: "Production") {
        Confirmation before destruction, async loading, and the debug
        tools that work on every app you build.

        @Image(source: "tutorial-tasks-card.png", alt: "The TerminalUI mascot.")

        @TutorialReference(tutorial: "doc:MakeItProduction")
    }
}
